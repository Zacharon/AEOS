{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-librarian-source-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "title", "source_type", "original_uri", "imported_at",
    "captured_at", "project", "content_sha256", "ingestion_method",
    "originating_agent", "source_reliability", "tags", "stored_path"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4}-[0-9]{6}$"},
    "title": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "original_uri": {"type": "string", "minLength": 1},
    "imported_at": {"$ref": "#/$defs/timestamp"},
    "captured_at": {"$ref": "#/$defs/timestamp"},
    "project": {"type": "string", "minLength": 1},
    "content_sha256": {"$ref": "#/$defs/hash"},
    "source_author": {"type": ["string", "null"]},
    "original_modified_at": {"$ref": "#/$defs/timestamp"},
    "ingestion_method": {"type": "string", "minLength": 1},
    "originating_agent": {"type": "string", "minLength": 1},
    "source_reliability": {
      "enum": [
        "owner_statement", "primary_source", "official_documentation",
        "direct_observation", "internal_project_artifact", "reputable_secondary",
        "community_report", "AI_generated", "unknown"
      ]
    },
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stored_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
